APP_NAME="Praxis Website Score"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_DATABASE=${DB_DATABASE}
DATABASE_URL=${DATABASE_URL}

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_placeholder_pro
STRIPE_PRICE_BUSINESS=price_placeholder_business

LOG_CHANNEL=stderr

# Feature Modules (true/false)
FEATURE_STRIPE=false
FEATURE_EMAIL_VERIFICATION=false
FEATURE_PASSWORD_RESET=false
FEATURE_API=false
FEATURE_ANALYTICS=false
FEATURE_NOTIFICATIONS=false
FEATURE_AFFILIATE=false
FEATURE_API_ACCESS=false
FEATURE_TEAM_MANAGEMENT=false
FEATURE_REPORTING=false
FEATURE_WHITE_LABEL=false
FEATURE_LEAD_CAPTURE=false

# Social Proof Module
FEATURE_SOCIAL_PROOF=false

# Review Collector Module
FEATURE_REVIEW_COLLECTOR=false
